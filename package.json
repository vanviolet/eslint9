{
    "name": "@vanviolet/eslint9",
    "version": "2.0.0",
    "author": "vanviolet.js@gmail.com",
    "license": "MIT",
    "description": "Paket konfigurasi ESLint 10 untuk JavaScript dan TypeScript",
    "keywords": [
        "eslint",
        "config",
        "vanviolet",
        "eslint-config"
    ],
    "type": "module",
    "main": "eslint.config.js",
    "bin": {
        "vlint": "bin/vlint.js"
    },
    "files": [
        "eslint.config.js",
        "override.js",
        "prettier.config.js",
        "bin/vlint.js",
        "plugins/eslint.js",
        "plugins/global.js",
        "plugins/ignore.recommended.js",
        "plugins/prettier.js",
        "plugins/typescript.js",
        "plugins/unused-imports.js"
    ],
    "dependencies": {
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "prompts": "^2.4.2"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    }
}
